[#Form: VehicleSalesVoucher]
Title: Sales Voucher - Vehicle Details
FormType: Sales
Repeat: VoucherLine

{Table: VehicleTable}
Field: VoucherNo		:	"Voucher No"
Field: Date			:	"Date"
Field: PartyName		:	"Party Name"
Field: VehicleNo		:	"Vehicle No"
Field: VehicleModel		:	"Vehicle Model"
Field: VehicleColor		:	"Vehicle Color"
Field: ChassisNo		:	"Chassis No"
Field: EngineNo		:	"Engine No"
Field: Amount			:	"Amount"

{Table: ItemLine}
Field: ItemName		:	"Item Name"
Field: Quantity		:	"Quantity"
Field: Rate			:	"Rate"
Field: Amount			:	"Amount"

{Part: VoucherHeader}
Line: VoucherNo, Date, PartyName
Line: VehicleNo, VehicleModel, VehicleColor
Line: ChassisNo, EngineNo, Amount

{Part: ItemDetails}
Line: ItemName, Quantity, Rate, Amount

{Part: Buttons}
Line: AddVehicle Button, ViewVehicle Button, PrintVoucher Button

{Button: AddVehicle}
OnClick: $$AddVehicleDetails

{Button: ViewVehicle}
OnClick: $$ViewVehicleDetails

{Button: PrintVoucher}
OnClick: $$PrintWithVehicle
